# Makefile for ST Sopwith
#
# Two interchangeable Atari backends:
#   STCMD_NO_TTY=1 stcmd make -f Makefile.atari              # BACKEND=atari
#   STCMD_NO_TTY=1 stcmd make -f Makefile.atari BACKEND=stdl # STDL
#
# stcmd mounts the current directory into the toolkit container and
# runs there, so everything the build touches has to live inside this
# repository. STDL does: extern/stdl is a submodule, and the library
# is built from it automatically when the archive is missing.
#
#   git clone --recurse-submodules <url>     # fresh clone
#   git submodule update --init              # existing clone
#
# The STDL build wants libstdl-cmini.a - libstdl.a compiled against
# the libcmini headers, since this game links -nostdlib -lcmini - so
# the automatic build uses STDL's `cmini` target, not its default one.
#
# Benchmarking: add SHOW_FPS=1 for the on-screen render-time counter
# and SOPWITH_STATS=1 for the STDL sprite-cache report at exit.

CC = m68k-atari-mint-gcc
BACKEND ?= atari
TARGET ?= build/SOPWITH.TOS
OBJDIR ?= obj/$(BACKEND)
BUILDDIR ?= build

# The submodule wins when it is present; a sibling checkout is the
# fallback, so the library and the game can still be worked on
# together. Override with STDL_DIR=<path>.
STDL_DIR ?= $(firstword $(wildcard extern/stdl) ../atarist-stdl)
STDL_LIB  = $(STDL_DIR)/libstdl-cmini.a

LIBCMINI = /freemint/libcmini/lib
CPPFLAGS += -I. -Isrc -Isrc/atari -DPLATFORM_ATARI_TOS -I/freemint/libcmini/include
CFLAGS ?= -Os -m68000 -fomit-frame-pointer -ffast-math -Wall -Wextra -std=c99
LDFLAGS ?= -nostdlib -L$(LIBCMINI)
LDLIBS ?= -lcmini -lgcc

# STDL plane budget (BACKEND=stdl only): the number of bitplanes
# STDL maintains. Sopwith draws in four colours, so 2 is right;
# PLANE_BUDGET=4 restores the previous behaviour for A/B timing.
PLANE_BUDGET ?= 2
CPPFLAGS += -DSOPWITH_PLANE_BUDGET=$(PLANE_BUDGET)

ifdef SHOW_FPS
CPPFLAGS += -DSHOW_FPS=$(SHOW_FPS)
endif
ifdef SOPWITH_STATS
CPPFLAGS += -DSOPWITH_STATS
endif

COMMON_SOURCES = \
	src/hiscore.c \
	src/swasynio.c \
	src/swauto.c \
	src/swcollsn.c \
	src/swconf.c \
	src/swend.c \
	src/swgames.c \
	src/swgrpha.c \
	src/swinit.c \
	src/swmain.c \
	src/swmenu.c \
	src/swmove.c \
	src/swobject.c \
	src/swsound.c \
	src/swsplat.c \
	src/swstbar.c \
	src/swsymbol.c \
	src/swtext.c \
	src/swtitle.c \
	src/touch_area.c \
	src/yocton.c \
	src/atari/tcpcomm_stub.c

ATARI_SOURCES = \
	src/atari/controller.c \
	src/atari/main.c \
	src/atari/pcsound.c \
	src/atari/timer.c \
	src/atari/video.c

STDL_SOURCES = \
	src/stdl/controller.c \
	src/stdl/main.c \
	src/stdl/pcsound.c \
	src/stdl/timer.c \
	src/stdl/video.c

ifeq ($(BACKEND),stdl)
BACKEND_SOURCES = $(STDL_SOURCES)
CPPFLAGS += -I$(STDL_DIR)/include
BACKEND_LIB = $(STDL_LIB)
# Cloning without --recurse-submodules leaves extern/stdl an empty
# directory; say so rather than failing on a missing STDL.h.
ifeq ($(wildcard $(STDL_DIR)/include),)
ifeq ($(filter clean run-%,$(MAKECMDGOALS)),)
$(error STDL not found in $(STDL_DIR) - run: git submodule update --init)
endif
endif
else ifeq ($(BACKEND),atari)
BACKEND_SOURCES = $(ATARI_SOURCES)
BACKEND_LIB =
else
$(error unknown BACKEND '$(BACKEND)': use atari or stdl)
endif

SOURCES = $(COMMON_SOURCES) $(BACKEND_SOURCES)
OBJECTS = $(patsubst %.c,$(OBJDIR)/%.o,$(SOURCES))

.PHONY: all clean run-st run-st512 run-ste run-megaste

all: $(TARGET)

$(TARGET): $(OBJECTS) $(BACKEND_LIB) | $(BUILDDIR)
	$(CC) $(LDFLAGS) -o $@ $(LIBCMINI)/crt0.o $(OBJECTS) $(BACKEND_LIB) $(LDLIBS)

# Build the library from the submodule when its archive is missing,
# so a fresh clone needs one command. An existing archive is left
# alone - rebuild it deliberately with make -C $(STDL_DIR) cmini.
$(STDL_LIB):
	$(MAKE) -C $(STDL_DIR) cmini

# The desktop build generates config.h with autotools and .gitignore
# excludes it, so a fresh clone has none and no object can be made.
# The Atari build has no configure step: seed it from the tracked
# template. No prerequisite, so an existing config.h is never touched.
config.h:
	@cp src/atari/config.h.atari $@

$(OBJDIR)/%.o: %.c config.h | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: %.S | $(OBJDIR)
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -c -o $@ $<

$(OBJDIR):
	@mkdir -p $@

$(BUILDDIR):
	@mkdir -p $@

clean:
	rm -rf obj $(BUILDDIR)

run-st: $(TARGET)
	hatari --machine st $(TARGET)

run-st512: $(TARGET)
	hatari --machine st --memsize 512 $(TARGET)

run-ste: $(TARGET)
	hatari --machine ste $(TARGET)

run-megaste: $(TARGET)
	hatari --machine megaste $(TARGET)
